class Solution {
    public int solve(String s, int i) {
        if (i == s.length()) {
            return 1;
        }
        if (s.charAt(i) == '0') {
            return 0;
        }
        int ways=solve(s,i+1);
        if(i+1<s.length()){
            int a=Integer.parseInt(s.substring(i,i+2));
            if(a >= 10 && a<= 26){
                ways+=solve(s,i+2);
            }
        }
        return ways;
    }
    public int numDecodings(String s) {
         if (s.length() == 0 || s.charAt(0) == '0') {
            return 0;
        }

        return solve(s, 0);
    }
}
